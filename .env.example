# Viraasat portal — copy to .env.local
# Defaults are mock-first: the portal demos with no backend running.

# Sarthi Core engine base URL
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8787

# true = use the offline AA mock in lib/aa.ts (no backend needed)
# false = call the engine's /aa/* endpoints
NEXT_PUBLIC_MOCK_AA=true
